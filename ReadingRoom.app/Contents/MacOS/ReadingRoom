#!/bin/bash
# ============================================================================
# Reading Room — macOS .app launcher (zero windows).
#
# This is the executable inside ReadingRoom.app. Double-clicking the app runs it
# WITHOUT opening any Terminal window: it starts the local server (workmode/)
# and the server opens the chromeless app window itself. Errors are shown as a
# native dialog (there's no console to print to).
#
# INVARIANTS (all learned the hard way — keep them):
#  * The server must run as this script's CHILD, with this script alive for the
#    whole session (`wait`). Detaching it (nohup … & + exit 0) does NOT work
#    from an .app: the moment the main executable exits, launchd tears down the
#    app's process group and kills the server before it can even write a log
#    line — double-click then silently does nothing. LSUIElement in Info.plist
#    keeps the running app out of the Dock, so staying alive shows no UI.
#  * The server runs in a LOOP: exit code 75 means "restart me" (the in-app
#    updater just installed a new version) — relaunch it, still as our child.
#    Any other exit code ends the session; nothing here can spin hot.
#  * User-facing dialog text says "Reading Room" / "the app" — file paths such
#    as workmode/workmode.log are the only place the folder name appears.
#
# The server auto-quits a few seconds after the app window closes, which ends
# this script too. Logs: workmode/workmode.log; pid: workmode/workmode.pid
# (force-stop with `kill $(cat workmode/workmode.pid)`).
#
# The static GitHub Pages browse path is unaffected; this only runs things locally.
# ============================================================================

# osascript is overridable so agents/tests can run this script headless without
# popping real dialogs (RR_OSASCRIPT=/path/to/stub). Humans never set it.
OSA="${RR_OSASCRIPT:-/usr/bin/osascript}"

# Repo root = three levels up from Contents/MacOS/ (…/ReadingRoom.app/Contents/MacOS)
REPO="$(cd "$(dirname "$0")/../../.." && pwd)" || exit 1
cd "$REPO" || exit 1

# Show a native error dialog (no console exists for an .app launch) and quit.
die() {
  "$OSA" -e "display dialog \"Reading Room\n\n$1\" buttons {\"OK\"} default button 1 with icon caution with title \"Reading Room\"" >/dev/null 2>&1
  exit 1
}
notify() {
  "$OSA" -e "display notification \"$1\" with title \"Reading Room\"" >/dev/null 2>&1
}

# --- pre-flight: can this app actually READ its own files? -------------------
# When the repo lives in a macOS-protected location (OneDrive/iCloud CloudStorage,
# Desktop, Documents, Downloads), TCC gates file access PER APP. Terminal usually
# has the grant; a double-clicked .app has its own — and when it's missing, reads
# fail with EPERM and the server dies before writing a single log line, so
# double-click silently does nothing. Detect that here and walk the user through
# the one-time grant instead. (Updating the app changes its TCC identity, so the
# grant may need re-doing after an update — same dialog, same 10 seconds.)
if ! cat "$REPO/workmode/package.json" >/dev/null 2>&1; then
  BTN="$("$OSA" -e 'button returned of (display dialog "Reading Room\n\nmacOS is blocking this app from reading its own folder (it lives in a protected location — OneDrive, Desktop or Documents).\n\nGrant access once in System Settings → Privacy & Security:\n• Files & Folders → ReadingRoom → allow the folder, or\n• Full Disk Access → + → add ReadingRoom.app\n\nThen open Reading Room again." buttons {"OK", "Open System Settings"} default button "Open System Settings" with icon caution with title "Reading Room")' 2>/dev/null)"
  [ "$BTN" = "Open System Settings" ] && open "x-apple.systempreferences:com.apple.preference.security?Privacy_AllFiles" >/dev/null 2>&1
  exit 1
fi

# First run only: offer a shortcut — on the Desktop (default) or in the
# Applications folder (/Applications when writable, else ~/Applications). A
# plain symlink named "Reading Room.app" — no Finder automation, so no
# permission prompts; Finder and Spotlight treat it like the app itself.
offer_shortcut() {
  MARKER="$REPO/user/.desktop-shortcut-offered"
  [ -f "$MARKER" ] && return 0
  mkdir -p "$REPO/user" && : >"$MARKER"   # one-shot, whatever they choose
  BTN="$("$OSA" -e 'button returned of (display dialog "Add a Reading Room shortcut?\n\nIt is just a link to this app — you can move or delete it any time." buttons {"Not now", "Applications folder", "Desktop"} default button "Desktop" with title "Reading Room" with icon note)' 2>/dev/null)"
  DEST="" WHERE=""
  case "$BTN" in
    "Desktop") DEST="$HOME/Desktop"; WHERE="your Desktop" ;;
    "Applications folder")
      if [ -w /Applications ]; then DEST="/Applications"; WHERE="the Applications folder"
      else DEST="$HOME/Applications"; WHERE="your Applications folder"; mkdir -p "$DEST" 2>/dev/null; fi ;;
    *) return 0 ;;
  esac
  [ -d "$DEST" ] || return 0
  # A real "Reading Room.app" (not a symlink) already there — an older copy, say —
  # must not be touched: `ln -sfn` would otherwise create the link INSIDE it.
  if [ -e "$DEST/Reading Room.app" ] && [ ! -L "$DEST/Reading Room.app" ]; then
    notify "A Reading Room.app already exists in $WHERE — shortcut not added."
    return 0
  fi
  if ! ln -sfn "$REPO/ReadingRoom.app" "$DEST/Reading Room.app" 2>/dev/null; then
    # /Applications looked writable but wasn't (ACLs) — fall back to the user's own.
    [ "$DEST" = "/Applications" ] || return 0
    DEST="$HOME/Applications"; WHERE="your Applications folder"
    mkdir -p "$DEST" 2>/dev/null && ln -sfn "$REPO/ReadingRoom.app" "$DEST/Reading Room.app" 2>/dev/null || return 0
  fi
  notify "Shortcut added to $WHERE."
}

# --- locate Node (an .app launch starts with a minimal PATH) -----------------
# Probe the usual install locations FIRST — instant and side-effect-free. Only
# if that fails, fall back to sourcing shell profiles, which can be slow or even
# hang here (e.g. a conda init hook waiting in a non-interactive context).
have_node() { command -v node >/dev/null 2>&1; }

if ! have_node; then
  for p in /opt/homebrew/bin /usr/local/bin "$HOME/.volta/bin"; do
    [ -x "$p/node" ] && export PATH="$p:$PATH"
  done
  for n in "$HOME"/.nvm/versions/node/*/bin "$HOME"/.fnm/node-versions/*/installation/bin; do
    [ -x "$n/node" ] && export PATH="$n:$PATH"
  done
fi
if ! have_node; then
  for f in "$HOME/.zprofile" "$HOME/.zshrc" "$HOME/.bash_profile" "$HOME/.bashrc" "$HOME/.profile"; do
    [ -f "$f" ] && . "$f" >/dev/null 2>&1
    have_node && break
  done
fi
if ! have_node; then
  if [ -s "$HOME/.nvm/nvm.sh" ]; then
    . "$HOME/.nvm/nvm.sh" >/dev/null 2>&1
    nvm use --silent default >/dev/null 2>&1 || nvm use --silent node >/dev/null 2>&1
  fi
fi

if ! have_node; then
  open "https://nodejs.org/en/download" >/dev/null 2>&1
  die "Reading Room needs Node.js, which was not found. Install it from nodejs.org (or: brew install node), then open Reading Room again."
fi

# --- require Node >= 18 up front (a too-old Node would fail cryptically
#     halfway through npm install instead of with a clear message) -----------
NODE_MAJOR="$(node -p 'process.versions.node.split(".")[0]' 2>/dev/null)"
case "$NODE_MAJOR" in
  ''|*[!0-9]*)
    die "Could not determine your Node.js version (node -v failed). Reinstall Node 18 or newer from nodejs.org, then open Reading Room again." ;;
esac
if [ "$NODE_MAJOR" -lt 18 ]; then
  open "https://nodejs.org/en/download" >/dev/null 2>&1
  die "Reading Room needs Node.js 18 or newer — found $(node -v). Update it from nodejs.org (or: brew upgrade node), then open Reading Room again."
fi

# --- install the server's dependencies on first run -------------------------
# npm install takes a minute or two, and a double-clicked .app shows NOTHING
# while it runs (no Dock icon, no window, no dialog) — without feedback a first
# launch looks dead, and a second impatient double-click would race this install.
# So: notify up front, and hold a lock for the duration.
LOCK="$REPO/workmode/.install.lock"
if [ ! -d "workmode/node_modules" ]; then
  if [ -f "$LOCK" ] && [ -n "$(find "$LOCK" -mmin -15 2>/dev/null)" ]; then
    notify "Still setting up (first run) — the window opens when it finishes."
    exit 0
  fi
  : >"$LOCK"
  notify "First-run setup (about a minute) — the window opens when it is ready."
  ( cd workmode && npm install --no-audit --no-fund ) >"$REPO/workmode/install.log" 2>&1
  RC=$?
  rm -f "$LOCK"
  [ "$RC" -ne 0 ] && die "Installing Reading Room's dependencies failed. See workmode/install.log for details."
  # node-pty is a native module; if npm's script policy skipped its build the app
  # would open with the terminal disabled — rebuild it explicitly in that case.
  if ! ( cd workmode && node -e "require('node-pty')" ) >/dev/null 2>&1; then
    ( cd workmode && npm rebuild node-pty ) >>"$REPO/workmode/install.log" 2>&1
  fi
fi

# --- already running? then there's nothing to do (its window is open) -------
# The pid must actually be OUR server — a recycled pid from a stale file would
# otherwise make double-click silently do nothing.
PIDFILE="$REPO/workmode/workmode.pid"
OLDPID="$(cat "$PIDFILE" 2>/dev/null)"
if [ -n "$OLDPID" ] && ps -p "$OLDPID" -o command= 2>/dev/null | grep -q "server\.js"; then
  exit 0
fi

# --- start the server as our child and stay alive for the session -----------
LOG="$REPO/workmode/workmode.log"
cd "$REPO/workmode" || die "Part of the app is missing (the workmode/ folder). Download Reading Room again."

# After an update restart, the page that asked for it stays open and reloads
# itself once the new server answers — so the relaunch must NOT open a second
# window (RR_NO_OPEN=1). The catch: the server only arms its own auto-quit when
# a window DISCONNECTS, so if that page was closed mid-restart the new server
# would sit there windowless forever, and the next double-click would see it
# "already running" and do nothing. This watches for that (bounded) and opens
# a window itself if nobody has connected. Runs in the background beside `wait`.
reopen_if_orphaned() {
  local srv="$1" url="" port="" i a
  for i in $(seq 1 90); do                     # the restart rebuilds docs/ first
    sleep 1
    kill -0 "$srv" 2>/dev/null || return 0
    url="$(grep -o 'http://127\.0\.0\.1:[0-9]*/' "$LOG" 2>/dev/null | head -n 1)"
    [ -n "$url" ] && break
  done
  [ -n "$url" ] || return 0
  sleep 20                                     # ample for the old page to reload + reconnect
  kill -0 "$srv" 2>/dev/null || return 0
  port="${url##*:}"; port="${port%/}"
  netstat -an -p tcp 2>/dev/null | grep -q "127\.0\.0\.1\.$port .*ESTABLISHED" && return 0
  for a in "Google Chrome" "Microsoft Edge" "Brave Browser" "Chromium"; do   # same order as the server
    if [ -d "/Applications/$a.app" ] || [ -d "$HOME/Applications/$a.app" ]; then
      open -na "$a" --args "--app=$url" --new-window >/dev/null 2>&1 && return 0
    fi
  done
  open "$url" >/dev/null 2>&1
}

RESTARTED=0
export RR_LAUNCHER=1      # tells the server this loop relaunches it on exit 75 (so "Restart now" is offered)
while :; do
  if [ "$RESTARTED" -eq 0 ]; then
    node server.js >"$LOG" 2>&1 &
  else
    RR_NO_OPEN=1 node server.js >"$LOG" 2>&1 &
  fi
  SRV=$!
  echo "$SRV" >"$PIDFILE"

  # If the server dies in its first seconds (port trouble, a broken update, …),
  # say why instead of failing silently.
  sleep 3
  if ! kill -0 "$SRV" 2>/dev/null; then
    # an exit 75 this early is still a "restart me" (an update applied right after
    # launch), not a failed start
    wait "$SRV"; RC=$?
    if [ "$RC" -eq 75 ]; then RESTARTED=1; notify "Update installed — restarting…"; continue; fi
    ERR="$(tail -n 3 "$LOG" 2>/dev/null | tr '"\\' "' ")"
    rm -f "$PIDFILE"
    # Died without writing a single log line = blocked by macOS file permissions
    # (per-file TCC can pass the pre-flight read yet still deny other files).
    if [ -z "$ERR" ]; then
      die "macOS blocked Reading Room before it could write a single log line.\n\nGrant access once in System Settings → Privacy & Security → Full Disk Access: click +, add ReadingRoom.app, then open Reading Room again."
    fi
    [ "$RESTARTED" -eq 1 ] && die "Reading Room could not start after the update.\n\n$ERR\n\nFull log: workmode/workmode.log — ask your AI assistant to run /update to finish it, or open Reading Room again."
    die "Reading Room failed to start.\n\n$ERR\n\nFull log: workmode/workmode.log"
  fi

  if [ "$RESTARTED" -eq 0 ]; then
    offer_shortcut
  else
    reopen_if_orphaned "$SRV" &
  fi

  wait "$SRV"
  RC=$?
  [ "$RC" -eq 75 ] || break                    # 75 = "restart me" (in-app update)
  RESTARTED=1
  notify "Update installed — restarting…"
done
rm -f "$PIDFILE"
exit 0
