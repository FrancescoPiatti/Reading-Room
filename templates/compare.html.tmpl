<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{TITLE_TEXT}} — {{SITE_TITLE}}</title>
<script>
  /* set theme before paint to avoid a flash of the wrong theme; light is default */
  (function () {
    try { if (localStorage.getItem('rr-theme') === 'dark') document.documentElement.setAttribute('data-theme', 'dark'); } catch (e) {}
  })();
</script>
<style>
/* fonts are self-hosted (../../assets/fonts/, via the inlined @font-face rules below) */
{{BASE_CSS}}
</style>
</head>
<body class="report compare">
<header class="topbar">
  <div class="topbar-inner">
    <a class="back" href="../../index.html">← {{SITE_TITLE}}</a>
    <button class="theme-toggle" type="button" aria-label="Toggle color theme" aria-pressed="false" title="Toggle light / dark theme">
      <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
      <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
    </button>
  </div>
</header>

<main class="wrap">
  <header>
    <p class="eyebrow">Comparison</p>
    <h1 class="title">{{TITLE_TEXT}}</h1>
    <p class="lead">{{LEAD}}</p>
    <div class="cpills">{{PILLS}}</div>
  </header>

  <section class="panel is-active" role="region" aria-label="Comparison">
    {{TABLE}}
    {{VERDICT}}
  </section>

  <footer class="foot">
    <a class="back" href="../../index.html">← {{SITE_TITLE}}</a>
    <span>added {{ADDED}}</span>
  </footer>
</main>

<script>
  window.MathJax = {
    tex: { inlineMath: [['\\(', '\\)']], displayMath: [['\\[', '\\]']] },
    options: { skipHtmlTags: ['script','noscript','style','textarea','pre','code'] }
  };
</script>
<script src="https://cdn.jsdelivr.net/npm/mathjax@3.2.2/es5/tex-mml-chtml.js"
        integrity="sha384-Wuix6BuhrWbjDBs24bXrjf4ZQ5aFeFWBuKkFekO2t8xFU0iNaLQfp2K6/1Nxveei"
        crossorigin="anonymous" id="MathJax-script" async></script>

<script>
  // theme toggle — persists to localStorage, light is default
  (function () {
    var root = document.documentElement;
    var btn = document.querySelector('.theme-toggle');
    if (!btn) return;
    function sync(){ btn.setAttribute('aria-pressed', root.getAttribute('data-theme') === 'dark' ? 'true' : 'false'); }
    sync();
    btn.addEventListener('click', function () {
      var dark = root.getAttribute('data-theme') === 'dark';
      if (dark) { root.removeAttribute('data-theme'); } else { root.setAttribute('data-theme', 'dark'); }
      try { localStorage.setItem('rr-theme', dark ? 'light' : 'dark'); } catch (e) {}
      sync();
    });
  })();
</script>
</body>
</html>
